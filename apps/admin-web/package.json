{
  "name": "xianyu-assistant-admin-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <27",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "vite --open",
    "prebuild": "npm run icons:generate",
    "build": "vite build && node ./scripts/dist-safety-check.mjs",
    "analyze": "vite build --mode analyze",
    "icons:generate": "node ./scripts/generate-icon-bundle.mjs",
    "serve": "vite preview",
    "pretest": "npm run icons:generate",
    "test": "tsx ./scripts/run-contract-tests.ts",
    "test:dashboard-overview": "tsx ./scripts/dashboard-overview-contract.test.ts",
    "test:truthful-states": "tsx ./scripts/admin-truthful-state-contract.test.ts",
    "test:access-boundary": "tsx ./scripts/admin-access-boundary-contract.test.ts",
    "test:http-errors": "tsx ./scripts/http-error-contract.test.ts",
    "test:notification-config": "tsx ./scripts/notification-config-state-contract.test.ts",
    "lint": "eslint --max-warnings=0",
    "fix": "eslint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint  \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky",
    "commit": "git-cz",
    "clean:dev": "tsx scripts/clean-dev.ts",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && node ./scripts/reproducible-build.test.mjs"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "core-js": false,
    "es5-ext": false,
    "esbuild@0.28.1": true,
    "fsevents": false,
    "vue-demi": false
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{html,htm}": [
      "prettier --write"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vue/reactivity": "^3.5.21",
    "@vueuse/core": "^13.9.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "next",
    "axios": "^1.12.2",
    "echarts": "^6.0.0",
    "element-plus": "2.14.3",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.10.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "qrcode.vue": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.21",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "11.4.6",
    "vue-router": "^4.5.1",
    "xgplayer": "^3.0.20"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@eslint/js": "^9.9.1",
    "@iconify-json/fluent": "1.2.52",
    "@iconify-json/icon-park-outline": "1.2.4",
    "@iconify-json/iconamoon": "1.2.2",
    "@iconify-json/line-md": "1.2.16",
    "@iconify-json/ri": "1.2.10",
    "@iconify-json/solar": "1.2.5",
    "@iconify-json/svg-spinners": "1.2.4",
    "@iconify-json/system-uicons": "1.2.4",
    "@iconify-json/vaadin": "1.2.1",
    "@types/node": "^24.0.5",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.0.5",
    "commitizen": "^4.3.0",
    "cz-git": "^1.11.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "globals": "^15.9.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.81.0",
    "stylelint": "^16.20.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.36.0",
    "tsx": "^4.20.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.9.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vue-demi": "^0.14.9",
    "vue-img-cutter": "^3.0.5",
    "vue-tsc": "~2.1.6"
  }
}
