# Copy to .env.production and replace every value before production deployment.
RELEASE_ID=release-YYYYMMDD-sequence
RELEASE_REVISION=replace-with-lowercase-git-commit-sha
DATABASE_MIGRATION_EVIDENCE_FILE=/etc/xianyupilot/release/migration-evidence.json
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-root-password-32chars
MYSQL_APP_USER=xianyu_app
MYSQL_APP_PASSWORD=replace-with-strong-mysql-app-password-32chars
CRAWLER_DB=xianyu_crawler
CRAWLER_DB_USER=crawler
CRAWLER_DB_PASSWORD=replace-with-strong-crawler-password-32chars
REDIS_PASSWORD=replace-with-strong-redis-password-32chars
ADMIN_JWT_SECRET=replace-with-strong-admin-jwt-secret-32chars
COOKIE_CRYPTO_SECRET=replace-with-strong-cookie-crypto-secret-32chars
INTERNAL_API_TOKEN=replace-with-strong-internal-api-token-32chars
OPS_METRICS_TOKEN=replace-with-strong-ops-metrics-token-32chars
IMAGE_PROXY_ALLOWED_HOSTS=cdn.example.com,images.example.com
AI_PROVIDER_ALLOWED_HOSTS=replace-with-approved-ai-provider-hosts
NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=
NOTIFICATION_SMTP_ALLOWED_HOSTS=
JWT_SECRET=replace-with-strong-jwt-secret-32chars
JWT_EXPIRE_SECONDS=86400
MEDIA_COOKIE_SECURE=true
MEDIA_SESSION_MAX_AGE_SECONDS=1200
UPLOAD_GOVERNANCE_ENABLED=true
# 存储配额已不再用于 enforcement（用户上传不受容量限制）。
# 字段保留仅为兼容已有部署环境变量，可省略；磁盘占用由每日自动清理 7 天前未引用图片约束。
UPLOAD_TENANT_QUOTA_BYTES=1073741824
UPLOAD_GLOBAL_QUOTA_BYTES=107374182400
UPLOAD_RATE_LIMIT_REQUESTS=30
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_MAX_CONCURRENT_PER_TENANT=2
UPLOAD_MAX_CONCURRENT_GLOBAL=8
UPLOAD_RETENTION_DAYS=365
JWT_ISSUER=xianyu-core-api
JWT_AUDIENCE=xianyu-user-api
ADMIN_SEED_ENABLED=false
BACKEND_PORT=18080
USER_WEB_PORT=5174
ADMIN_WEB_PORT=3006
ADMIN_CORS_ALLOWED_ORIGINS=https://admin.example.com
ADMIN_CORS_ALLOWED_ORIGIN_PATTERNS=
USER_CORS_ALLOWED_ORIGINS=https://app.example.com
USER_CORS_ALLOWED_ORIGIN_PATTERNS=
WORKER_INTERVAL_SECONDS=60
CRAWLER_CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
CRAWLER_BROWSER_CONCURRENCY=4
CRAWLER_BROWSER_CONCURRENCY_PER_TENANT=2
CRAWLER_QR_SESSION_TTL_MS=180000
PAYMENT_SANDBOX_ENABLED=false

# 住址IP代理池（方案 E/H，2026-08-02 起生产启用）。
# USE_RESIDENTIAL_PROXY=true 时 crawler-service 使用住址IP代理池替代服务器数据中心IP，
# 规避 Baxia IP 级风控，滑块求解成功率大幅提升。API_URL 为代理供应商提取接口
# （当前为 shenlongip 神龙代理，pattern=txt、count=1）；API_URLS 支持多源逗号分隔聚合。
USE_RESIDENTIAL_PROXY=false
RESIDENTIAL_PROXY_API_URL=
RESIDENTIAL_PROXY_API_URLS=
RESIDENTIAL_PROXY_TTL_SEC=180
RESIDENTIAL_PROXY_POOL_SIZE=10
RESIDENTIAL_PROXY_FETCH_TIMEOUT_MS=8000
RESIDENTIAL_PROXY_FETCH_QTY=1
RESIDENTIAL_PROXY_MIN_FETCH_INTERVAL_MS=2000
RESIDENTIAL_PROXY_QUOTA_RECOVERY_SEC=600
RESIDENTIAL_PROXY_SOURCE_MAX_FAILURES=5
RESIDENTIAL_PROXY_SOURCE_BACKOFF_SEC=120
RESIDENTIAL_PROXY_RATE_LIMIT_BACKOFF_SEC=3
# shenlongip 白名单自动管理（启动时自动检查/添加服务器公网 IP）
SHENLONGIP_WHITE_API_URL=http://api.shenlongip.com/white
SHENLONGIP_WHITE_KEY=18074594914
SHENLONGIP_WHITE_SIGN=
# 住址IP质量评估：评分低于阈值进入黑名单的时长（秒）
PROXY_QUALITY_BLACKLIST_SEC=1800

# 滑块求解浏览器后端切换（CloakBrowser 反指纹浏览器，2026-08-04 支持）。
# cloakbrowser 需要生产容器安装 cloakbrowser 并配置 CLOAK_SOLVER_SCRIPT 路径；默认 patchright。
SLIDER_BROWSER_BACKEND=patchright
CLOAK_SOLVER_SCRIPT=/app/cloakbrowser_solve.py

# x5sec 主动刷新后台任务（2026-08-04）：每 20 小时扫描一次 cookie 有效账号，
# 对 x5sec 缓存剩余 TTL < 4 小时的账号提前用纯 HTTP 提取刷新（不触发滑块）。
X5SEC_REFRESH_INTERVAL_SEC=72000
X5SEC_REFRESH_TTL_THRESHOLD_SEC=14400
X5SEC_REFRESH_MAX_ACCOUNTS=20

# 方案 K（MTOP 签名逆向研究，默认关闭；PLAN_K_SAMPLE_LOGGING 默认开启样本记录）
PLAN_K_ENABLED=false
PLAN_K_SAMPLE_LOGGING=true
PLAN_K_PERSIST_SAMPLES=false
PLAN_K_SAMPLE_DIR=/tmp/x5sec_samples

# Required hard ceilings. Replace every value with limits approved by a
# production-like load/endurance test; these placeholders intentionally fail
# the production preflight and are not sizing recommendations.
#
# 性能调优参考值（8核16G 服务器，60G 磁盘）：
#   MySQL:  mem_limit=12G  cpus=6  pids=20000  （Buffer Pool 8G + 临时表 + 连接 + Binlog Cache）
#   Redis:  mem_limit=2G   cpus=1  pids=2000   （maxmemory 1G + RDB/AOF 开销）
#   PostgreSQL: mem_limit=2G  cpus=1  pids=2000 （crawler-service 使用，数据量小）
#   Backend (Java): mem_limit=3G  cpus=2  pids=2000  （-XX:MaxRAMPercentage=75 ≈ 2.25G 堆）
MYSQL_MEMORY_LIMIT_BYTES=12884901888
MYSQL_CPUS=6
MYSQL_PIDS_LIMIT=20000
MYSQL_INNODB_BUFFER_POOL_SIZE=4G
MYSQL_INNODB_LOG_FILE_SIZE=1G
MYSQL_MAX_CONNECTIONS=500
REDIS_MEMORY_LIMIT_BYTES=2147483648
REDIS_CPUS=1
REDIS_PIDS_LIMIT=2000
REDIS_MAXMEMORY=1gb
POSTGRES_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
POSTGRES_CPUS=replace-with-measured-cpus
POSTGRES_PIDS_LIMIT=replace-with-measured-pids
CORE_API_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
CORE_API_CPUS=replace-with-measured-cpus
CORE_API_PIDS_LIMIT=replace-with-measured-pids
AUTOMATION_API_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
AUTOMATION_API_CPUS=replace-with-measured-cpus
AUTOMATION_API_PIDS_LIMIT=replace-with-measured-pids
AUTOMATION_WORKER_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
AUTOMATION_WORKER_CPUS=replace-with-measured-cpus
AUTOMATION_WORKER_PIDS_LIMIT=replace-with-measured-pids
CRAWLER_API_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
CRAWLER_API_CPUS=replace-with-measured-cpus
CRAWLER_API_PIDS_LIMIT=replace-with-measured-pids
CRAWLER_WORKER_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
CRAWLER_WORKER_CPUS=replace-with-measured-cpus
CRAWLER_WORKER_PIDS_LIMIT=replace-with-measured-pids
USER_WEB_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
USER_WEB_CPUS=replace-with-measured-cpus
USER_WEB_PIDS_LIMIT=replace-with-measured-pids
ADMIN_WEB_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
ADMIN_WEB_CPUS=replace-with-measured-cpus
ADMIN_WEB_PIDS_LIMIT=replace-with-measured-pids
BLACKBOX_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
BLACKBOX_CPUS=replace-with-measured-cpus
BLACKBOX_PIDS_LIMIT=replace-with-measured-pids
ALERTMANAGER_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
ALERTMANAGER_CPUS=replace-with-measured-cpus
ALERTMANAGER_PIDS_LIMIT=replace-with-measured-pids
PROMETHEUS_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
PROMETHEUS_CPUS=replace-with-measured-cpus
PROMETHEUS_PIDS_LIMIT=replace-with-measured-pids
GRAFANA_MEMORY_LIMIT_BYTES=replace-with-measured-memory-bytes
GRAFANA_CPUS=replace-with-measured-cpus
GRAFANA_PIDS_LIMIT=replace-with-measured-pids

# Open-source bridge token (shared with open-source deployments).
# Must match COMMERCIAL_BACKEND_ACCESS_TOKEN in the open-source .env file.
OPEN_SOURCE_BRIDGE_TOKEN=replace-with-strong-open-source-bridge-token-64chars
OPEN_SOURCE_BRIDGE_SITE_CODE=open-source
OPEN_SOURCE_BRIDGE_SITE_NAME=开源版

# Commercial backend bridge (used by the commercial deployment to call the
# open-source backend). COMMERCIAL_BACKEND_ACCESS_TOKEN must be at least 32
# URL-safe ASCII characters and match OPEN_SOURCE_BRIDGE_TOKEN.
COMMERCIAL_BACKEND_URL=http://commercial-backend.example.com
COMMERCIAL_BACKEND_ACCESS_TOKEN=replace-with-strong-commercial-backend-token-64chars
COMMERCIAL_BACKEND_SITE_CODE=open-source
COMMERCIAL_BACKEND_SITE_NAME=开源版
PAYMENT_EXTERNAL_BASE_URL=http://backend.example.com:18080
# Production schema mutations are always disabled. Keep this false in production.
# 注意：变量名必须与 application.yml 占位符 ${SCHEMA_RUNTIME_MUTATIONS_ENABLED:true} 一致，
# 不能带 XIANYU_ 前缀，否则 Spring Boot 无法识别，会回退到默认值 true。
SCHEMA_RUNTIME_MUTATIONS_ENABLED=false

# Data sync bridge token (local open-source -> commercial backend).
# Must be at least 32 URL-safe ASCII characters and match the targetToken
# configured in BusinessSettingsService.java on the local sender side.
DATA_SYNC_API_TOKEN=replace-with-strong-data-sync-api-token-32chars

# AES-GCM secret used to encrypt API credential keys at rest.
# Must be at least 32 URL-safe ASCII characters.
API_KEY_CRYPTO_SECRET=replace-with-strong-api-key-crypto-secret-32chars

# Monitoring overlay. Set MONITORING_ENABLED=true to deploy the monitoring
# stack (Prometheus, Grafana, Alertmanager, Blackbox Exporter) and enforce
# the monitoring secret file requirements. When false, monitoring containers
# are not deployed and monitoring env keys are not required.
MONITORING_ENABLED=false
# Numeric GID of the dedicated host group that may read monitoring secrets.
# All monitoring secret files use 0440/0640 and their parent directory uses 0750.
# Required only when MONITORING_ENABLED=true.
MONITORING_SECRET_GID=64000
OPS_METRICS_TOKEN_FILE=/etc/xianyupilot/secrets/ops_metrics_token
ALERTMANAGER_WEBHOOK_URL_FILE=/etc/xianyupilot/secrets/alertmanager_webhook_url
GRAFANA_ADMIN_PASSWORD_FILE=/etc/xianyupilot/secrets/grafana_admin_password
ALERTMANAGER_PORT=9093
ALERTMANAGER_ROOT_URL=http://localhost:9093
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=replace-with-measured-retention-size
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=https://grafana.example.com
